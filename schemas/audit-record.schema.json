{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rfip:schema:audit-record:0.2.0",
  "title": "RFIP Audit Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "flow_id",
    "origin_id",
    "trace_id",
    "decision",
    "checks",
    "audited_at",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "audit_id": {
      "type": "string",
      "minLength": 1
    },
    "flow_id": {
      "type": "string",
      "minLength": 1
    },
    "origin_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "held"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "audited_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "$ref": "urn:rfip:schema:signature-envelope:0.2.0"
    }
  }
}
