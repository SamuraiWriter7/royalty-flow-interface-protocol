{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rfip:schema:flow-receipt:0.4.0",
  "title": "RFIP Flow Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "flow_id",
    "flow_request_id",
    "status",
    "received_at",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "0.4.0"
    },
    "flow_id": {
      "type": "string",
      "minLength": 1
    },
    "flow_request_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected"
      ]
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "$ref": "urn:rfip:schema:signature-envelope:0.4.0"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "rejected"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    }
  ]
}
