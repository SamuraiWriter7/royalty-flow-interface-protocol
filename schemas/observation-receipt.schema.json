{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rfip:schema:observation-receipt:0.5.0",
  "title": "RFIP Observation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "observer_id",
    "target_record_type",
    "target_record_id",
    "target_digest",
    "digest_algorithm",
    "canonicalization",
    "observed_at",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "0.5.0"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "observer_id": {
      "type": "string",
      "minLength": 1
    },
    "target_record_type": {
      "type": "string",
      "enum": [
        "flow-request",
        "flow-receipt",
        "trace-record",
        "audit-record",
        "settlement-receipt"
      ]
    },
    "target_record_id": {
      "type": "string",
      "minLength": 1
    },
    "target_digest": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "digest_algorithm": {
      "const": "SHA-256"
    },
    "canonicalization": {
      "const": "JCS-RFC8785"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "$ref": "urn:rfip:schema:signature-envelope:0.5.0"
    }
  }
}
