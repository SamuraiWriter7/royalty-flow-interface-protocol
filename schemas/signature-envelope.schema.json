{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rfip:schema:signature-envelope:0.5.0",
  "title": "RFIP Signature Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "algorithm",
    "key_id",
    "signer_id",
    "canonicalization",
    "scope",
    "encoding",
    "signed_at",
    "value"
  ],
  "properties": {
    "algorithm": {
      "const": "Ed25519"
    },
    "key_id": {
      "type": "string",
      "minLength": 1
    },
    "signer_id": {
      "type": "string",
      "minLength": 1
    },
    "canonicalization": {
      "const": "JCS-RFC8785"
    },
    "scope": {
      "const": "record-without-signature-value"
    },
    "encoding": {
      "const": "base64url"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "value": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  }
}
