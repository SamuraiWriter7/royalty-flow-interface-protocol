{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rfip:schema:verification-key-registry:0.3.0",
  "title": "RFIP Verification Key Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "keys"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "controller_id",
          "algorithm",
          "public_key_jwk"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "minLength": 1
          },
          "controller_id": {
            "type": "string",
            "minLength": 1
          },
          "algorithm": {
            "const": "Ed25519"
          },
          "public_key_jwk": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kty",
              "crv",
              "x"
            ],
            "properties": {
              "kty": {
                "const": "OKP"
              },
              "crv": {
                "const": "Ed25519"
              },
              "x": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{43}$"
              }
            }
          }
        }
      }
    }
  }
}
