{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rfip:schema:trace-record:0.5.0",
  "title": "RFIP Trace Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "origin_id",
    "route",
    "created_at",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "0.5.0"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "origin_id": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_type",
          "node_id"
        ],
        "properties": {
          "node_type": {
            "type": "string",
            "enum": [
              "origin",
              "derivative",
              "actor"
            ]
          },
          "node_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "$ref": "urn:rfip:schema:signature-envelope:0.5.0"
    }
  }
}
     
