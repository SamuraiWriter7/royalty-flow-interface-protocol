{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rfip:schema:flow-request:0.2.0",
  "title": "RFIP Flow Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "flow_request_id",
    "actor_id",
    "origin_id",
    "trace_id",
    "value",
    "occurred_at",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "flow_request_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "origin_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "$ref": "urn:rfip:schema:value:0.2.0"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "$ref": "urn:rfip:schema:signature-envelope:0.2.0"
    }
  }
}
